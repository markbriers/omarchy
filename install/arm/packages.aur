# Base packages that Arch Linux ARM does not build, but that do have an AUR
# PKGBUILD that builds on aarch64.
#
# These are the optional ones: applications and themes. The AUR packages the
# desktop actually needs are in packages.aur-required and are installed either
# way.
#
# Format: <package name> [aur package name if it differs]
# Installed with omarchy-pkg-aur-add, which means makepkg compiles them on the
# machine. On a Raspberry Pi that is slow, so they are left out unless
# --with-aur is passed.

aether
cliamp
herdr
tensaku
localsend
tzupdate
yaru-icon-theme
ttf-ia-writer
