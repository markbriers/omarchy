#!/bin/bash

# omarchy:summary=Print the name a package is published under on aarch64
# omarchy:args=<package>
# omarchy:hidden=true

pkg="${1-}"

if [[ -z $pkg ]]; then
  echo "Usage: omarchy-pkg-arm-name <package>" >&2
  exit 1
fi

# Off aarch64 this is a pass-through, so callers can pipe every package through
# it without branching on the architecture themselves.
if [[ $(uname -m) != aarch64 ]]; then
  echo "$pkg"
  exit 0
fi

# Arch Linux ARM has no generic linux-headers package: headers are named after
# the kernel that is actually installed, which is linux-aarch64 on a generic
# machine and linux-rpi on the Raspberry Pi kernel. That makes the substitution
# a property of the machine rather than a line in packages.replace.
if [[ $pkg == linux-headers ]]; then
  kernel=$(pacman -Qq 2>/dev/null | grep -m1 -E '^linux(-aarch64|-rpi[0-9]*)$')
  echo "${kernel:-linux-aarch64}-headers"
  exit 0
fi

replace="${OMARCHY_PATH:-/usr/share/omarchy}/install/arm/packages.replace"

if [[ -r $replace ]]; then
  while read -r from to _; do
    [[ -z $from || $from == \#* ]] && continue
    if [[ $from == "$pkg" ]]; then
      echo "$to"
      exit 0
    fi
  done <"$replace"
fi

echo "$pkg"
