#!/bin/bash

# omarchy:summary=Install Arch packages if they are missing
# omarchy:args=<packages...>
# omarchy:examples=omarchy pkg add jq ripgrep
# omarchy:requires-sudo=true
#
# Exit 90 means: everything that could be installed was, and what was left out
# was left out on purpose -- no build exists for this architecture, or the only
# source is an AUR build nobody has agreed to run yet. Callers that must keep
# going on ARM (omarchy-migrate) treat it as a skip rather than a failure.

packages=("$@")
arch_skipped=0

# On aarch64 the [omarchy] repository is not in pacman.conf, because it has no
# aarch64 tree. Everything Omarchy publishes there -- and every AUR binary it
# rebuilds for its users -- therefore resolves to nothing here, and pacman can
# only say "target not found". Sort the names out first so the message names
# the actual reason, and so the packages the AUR does build for aarch64 stay
# installable instead of looking like they are gone.
if [[ $(uname -m) == aarch64 ]]; then
  declare -a repo_packages=() aur_packages=()

  for pkg in "${packages[@]}"; do
    name=$(omarchy-pkg-arm-name "$pkg")
    read -r source reason <<<"$(omarchy-pkg-arm-source "$name")"

    case $source in
    repo) repo_packages+=("$name") ;;
    aur) aur_packages+=("$name") ;;
    *)
      echo -e "\033[31mError: '$pkg' has no aarch64 build: $reason\033[0m" >&2
      arch_skipped=1
      ;;
    esac
  done

  if ((${#aur_packages[@]} > 0)); then
    echo "Not in the Arch Linux ARM repositories, but the AUR builds these for aarch64: ${aur_packages[*]}"

    # Compiling is the user's call, not a silent side effect of asking for an
    # app: an AUR build can pull a toolchain and run for an hour. Menu installs
    # get a terminal, so the question reaches someone; scripted callers get the
    # command to run instead.
    build=0
    if [[ -t 0 ]]; then
      read -rp "Build them from source? This can take a long time [y/N] " answer
      [[ $answer == [yY]* ]] && build=1
    else
      echo "Install them with: omarchy pkg aur add ${aur_packages[*]}" >&2
    fi

    if ((build)); then
      omarchy-pkg-aur-add "${aur_packages[@]}" || exit 1
    else
      arch_skipped=1
    fi
  fi

  # Whatever the repositories do carry is still installed. Refusing the whole
  # batch over one package that cannot exist here would mean a list of twelve
  # apps installs none of them because one of them is Obsidian.
  packages=("${repo_packages[@]}")
fi

if ((${#packages[@]} > 0)) && omarchy-pkg-missing "${packages[@]}"; then
  if ((EUID == 0)); then
    pacman -S --noconfirm --needed "${packages[@]}" || exit 1
  else
    sudo pacman -S --noconfirm --needed "${packages[@]}" || exit 1
  fi
fi

for pkg in "${packages[@]}"; do
  # Secondary check to handle states where pacman doesn't actually register an error
  if ! pacman -Q "$pkg" &>/dev/null; then
    echo -e "\033[31mError: Package '$pkg' did not install\033[0m" >&2
    exit 1
  fi
done

((arch_skipped)) && exit 90

exit 0
